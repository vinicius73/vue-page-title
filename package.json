{
  "name": "vue-page-title",
  "version": "3.0.0",
  "description": "Vue.js html/page title manager",
  "repository": "https://github.com/vinicius73/vue-page-title",
  "author": "Vinicius Reis <luiz.vinicius73@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vue",
    "head",
    "title",
    "document",
    "meta"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:doc": "vue-tsc --noEmit && vite build -c vite.config.example.ts && typedoc",
    "prepack": "yarn run build",
    "dev": "vite dev -c vite.config.example.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint lib example",
    "lint:fix": "oxlint --fix lib example",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "yarn lint && yarn format:check"
  },
  "peerDependencies": {
    "vue": "^3.2",
    "vue-router": "^4.1"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.0",
    "mini-svg-data-uri": "^1.4.4",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.16.0",
    "radash": "^12.1.0",
    "reseter.css": "^2.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.0",
    "vue": "^3.5.39",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "yarn@3.3.0"
}
